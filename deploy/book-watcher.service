[Unit]
Description=Book Watcher (EPUB read aloud as subtitles)
After=network-online.target
Wants=network-online.target

[Service]
User=bookwatcher
Group=bookwatcher
EnvironmentFile=/etc/book-watcher.env
Environment=BW_HOST=127.0.0.1 BW_PORT=8765 BW_DATA=/var/lib/book-watcher
ExecStart=/opt/book-watcher/.venv/bin/book-watcher --no-browser
StateDirectory=book-watcher
Restart=on-failure
RestartSec=3

# Sized for a small shared VPS: cap memory, and let the OOM killer pick this service first.
MemoryHigh=160M
MemoryMax=240M
OOMScoreAdjust=500

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
